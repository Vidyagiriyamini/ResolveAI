# Copy this file to .env and replace the placeholders with your own values.

# Application
NODE_ENV=development
PORT=3000

# PayPal - Sandbox only
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_YOUR_SANDBOX_CLIENT_SECRET

# PayPal webhook - configure after HTTPS deployment
PAYPAL_WEBHOOK_ID=

# ResolveAI operator authentication
RESOLVEAI_OPERATOR_USERNAME=operator
RESOLVEAI_OPERATOR_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
RESOLVEAI_SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS

# Comma-separated allowed frontend origins
RESOLVEAI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: leave empty to use the application's default database location
RESOLVEAI_DB_PATH=
